# 全额秒退：东京时间每日 17:00 截止（支付早于17:00→当日17:00锁定；晚于17:00→次日17:00锁定）
# ORDER_INSTANT_REFUND_DAILY_LOCK_AT=17:00
# ORDER_INSTANT_REFUND_DAILY_LOCK_TIMEZONE=Asia/Tokyo

# 每日自动导出到 Google 云端硬盘（仅 A 站，东京时间 17:00 = 下午5点）
DAILY_EXPORT_ENABLED=false
DAILY_EXPORT_TIMEZONE=Asia/Tokyo
DAILY_EXPORT_RUN_AT=17:00
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=/www/myshop/storage/app/google-service-account.json
GOOGLE_DRIVE_FOLDER_ORDERS=1YrDGG-44gL0jAIwS8dGWxcNXE4vEYF4W
GOOGLE_DRIVE_FOLDER_STOCK_PREP=1mfwb1DwSeK5grJksGYtJG5TB1ns9LVif
# 个人 Gmail 必填（服务账号无法写入「我的云端硬盘」）：
# GOOGLE_DRIVE_OAUTH_CLIENT_ID=
# GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
# GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
# Google Workspace 可选（共享云端硬盘）：
# GOOGLE_DRIVE_SUPPORTS_ALL_DRIVES=true
# GOOGLE_DRIVE_IMPERSONATE_EMAIL=

# 后台安全（生产务必修改 ADMIN_ROUTE_PREFIX，勿使用 admin）
ADMIN_ROUTE_PREFIX=mgmt-k8f3n7p2x
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_MINUTES=15
ADMIN_LOGIN_CAPTCHA_AFTER=3
ADMIN_PASSWORD_MIN_LENGTH=16
ADMIN_PASSWORD_REMIND_DAYS=90

# 联华速递 EMS 单号自动同步（仅 A 站后台发货）
